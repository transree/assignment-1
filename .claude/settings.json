{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ls *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Edit(/AGENTS.md)",
      "Edit(/README.md)",
      "Edit(/eval/run.sh)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/cases/0*/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.py\"" }
        ]
      }
    ]
  }
}
